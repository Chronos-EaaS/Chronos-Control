<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="https://schema.phpunit.de/12.5/phpunit.xsd"
         bootstrap="tests/bootstrap.php"
         cacheDirectory=".phpunit.cache"
         colors="true"
         failOnWarning="true"
         failOnRisky="true"
         beStrictAboutOutputDuringTests="true">
    <testsuites>
        <testsuite name="Legacy domain characterization">
            <directory>tests/unit</directory>
        </testsuite>
    </testsuites>
    <php>
        <ini name="date.timezone" value="Europe/Zurich"/>
        <ini name="error_reporting" value="-1"/>
    </php>
    <source>
        <include>
            <directory>src</directory>
            <file>legacy/core/define.php</file>
            <file>legacy/core/element.php</file>
            <file>legacy/core/plot.php</file>
            <file>legacy/core/util.php</file>
            <file>legacy/libraries/builder.php</file>
            <file>legacy/libraries/cdl.php</file>
            <file>legacy/libraries/results.php</file>
            <directory>legacy/libraries/elements</directory>
            <directory>legacy/libraries/graphs</directory>
        </include>
    </source>
</phpunit>
