{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "types": [
      "node"
    ]
  },
  "include": [
    "playwright.config.ts",
    "playwright.v3.config.ts",
    "tests/v3/**/*.ts",
    "tests/e2e/**/*.ts",
    "tests/http/**/*.ts"
  ]
}
