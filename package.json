{
  "name": "chronos-control",
  "version": "3.0.0-dev",
  "private": true,
  "description": "Chronos Control development and regression tools",
  "engines": {
    "node": ">=24.15.0"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test:e2e:legacy": "playwright test",
    "test:e2e:chromium": "playwright test --project=desktop-chromium",
    "test:e2e:list": "playwright test --list"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "26.6.5",
    "typescript": "7.0.2"
  }
}
