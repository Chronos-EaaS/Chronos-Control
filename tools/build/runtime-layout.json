{
  "format": 1,
  "runtimeLayout": "application-v1",
  "mappings": [
    { "source": "backend/bin/live.php", "destination": "api/live.php", "kind": "file" },
    { "source": "backend/ops", "destination": "api/live-ops", "kind": "directory" },
    { "source": "backend/src", "destination": "app", "kind": "directory" },
    { "source": "backend/http/v1", "destination": "api/v1", "kind": "directory" },
    { "source": "backend/http/ui", "destination": "api/ui", "kind": "directory" },
    { "source": "backend/public", "destination": "webroot", "kind": "directory" },
    { "source": "backend/resources/constants.php", "destination": "constants.php", "kind": "file" },
    { "source": "backend/resources/chronos.sql", "destination": "chronos.sql", "kind": "file" },
    { "source": "backend/resources/config.template.php", "destination": "config.template.php", "kind": "file" },
    { "source": "backend/resources/install.php", "destination": "install.php", "kind": "file" },
    { "source": "backend/resources/.htaccess", "destination": ".htaccess", "kind": "file" }
  ],
  "excludedRuntimePrefixes": ["webroot/systems", "webroot/data", "webroot/media", "webroot/ui"],
  "historicalRuntimeRoots": ["app", "api", "controllers", "core", "libraries", "templates", "views", "webroot", "constants.php", "chronos.sql", "config.template.php", ".htaccess", "install.php"]
}
